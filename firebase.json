{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".github/**",
      "gen-icons.js",
      "README.md",
      "node_modules/**"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
      },
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "X-Frame-Options", "value": "DENY"}
        ]
      }
    ],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
